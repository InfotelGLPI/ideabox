<div id="searchidea"></div>

<div tabindex="-1" id="fuzzysearch" style="margin-right: auto; margin-top: 20px;">
    <div class="modal-content" style="background-color: transparent !important;">
        <div class="modal-body" style="padding: unset; background-color: transparent !important; width: 100%;">
            <div class="input-group">
                <input type="text" class="{{ trigger_class }} form-control" placeholder="{{ placeholder }}">
                <input type="hidden" name="fuzzy-strict" id="fuzzy-strict" value="1">
                <div class="input-group-prepend">
                    <span class="input-group-text input-group-text-search" style="padding: 10px;">
                        <i class="ti ti-search"></i>
                    </span>
                </div>
            </div>
            <ul class="results list-group mb-2" style="background-color: transparent;"></ul>
        </div>
    </div>
</div>
