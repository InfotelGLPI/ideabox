{#
 # Clicking the button or a row loads the translation form in the container: handled by
 # public/scripts/config-translation.js from the data-* attributes.
 #}
{% set datatable_id = 'translationlist' ~ rand %}

{% if canedit %}
    <div class="text-center">
        <button type="button" class="btn btn-primary" data-ideabox-translation-add="viewtranslation{{ rand }}">
            {{- __('Add a new translation') -}}
        </button>
    </div>
    <div id="viewtranslation{{ rand }}" class="mb-3"
         data-ideabox-translation-view="{{ view_url }}"
         data-ideabox-translation-datatable="{{ datatable_id }}"
         data-type="{{ type }}"
         data-parenttype="{{ parenttype }}"
         data-items-id="{{ items_id }}"></div>
    <script type="module" src="{{ script_url }}"></script>
{% endif %}

{{ include('components/datatable.html.twig', {
    'datatable_id': datatable_id,
    'is_tab': true,
    'nofilter': true,
    'columns': {
        'language': __('Language'),
        'field': _n('Field', 'Fields', 1),
        'value': __('Value'),
    },
    'formatters': {
        'value': 'raw_html',
    },
    'entries': entries,
    'total_number': entries|length,
    'filtered_number': entries|length,
    'showmassiveactions': canedit,
    'massiveactionparams': {
        'num_displayed': min(session('glpilist_limit'), entries|length),
        'container': container,
        'specific_actions': {'purge': _x('button', 'Delete permanently')},
    },
}, with_context = false) }}
